{
  "name": "microflow4verify",
  "version": "0.1.0",
  "description": "MicroFlow 端到端验收运行器：声明式 UI 验收脚本在真实渲染面（web = MFRuntime）执行，产出 microflow-verify-v1 证据信封。",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.7" },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "node --experimental-transform-types src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
