{
  "name": "microflow4web",
  "version": "0.1.0",
  "description": "MicroFlow Frontend 的 Web DOM 渲染器：MFProject(JSON) → 现代 web 平台原语（语义 HTML / View Transitions / popover / native dialog / oklch token / scroll-driven animations）。",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/renderer/styles.css"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@vitest/environment-happy-dom": "npm:happy-dom@^18.0.0",
    "happy-dom": "^18.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
