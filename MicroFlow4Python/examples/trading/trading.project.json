{
  "modules": ["trading_ops.py"],
  "flows": [
    {
      "id": "browse",
      "input_schema": "trading.browse.input@1",
      "output_schema": "trading.browse.output@1",
      "options": {"scene": "trading.browse", "version": "trading.browse@1"},
      "nodes": {
        "search": {
          "operator": "trading.catalog_search@1",
          "inputs": {"keyword": {"from": "flow.input.keyword", "required": true}}
        }
      },
      "outputs": {"products": {"from": "nodes.search.output.data.products", "required": true}}
    },
    {
      "id": "pricing",
      "input_schema": "trading.pricing.pass@1",
      "output_schema": "trading.pricing.result@1",
      "options": {"scene": "trading.pricing", "version": "trading.pricing@1"},
      "nodes": {
        "total": {
          "operator": "trading.cart_total@1",
          "inputs": {"items": {"from": "flow.input.items", "required": true},
                     "vip": {"from": "flow.input.vip", "required": true}}
        },
        "discount": {
          "operator": "trading.pricing_discount@1",
          "depends_on": ["total"],
          "inputs": {"total": {"from": "nodes.total.output.data.total", "required": true},
                     "vip": {"from": "flow.input.vip", "required": true}}
        }
      },
      "outputs": {
        "total": {"from": "nodes.total.output.data.total", "required": true},
        "payable": {"from": "nodes.discount.output.data.payable", "required": true},
        "saved": {"from": "nodes.discount.output.data.saved", "required": true}
      }
    },
    {
      "id": "place_order",
      "input_schema": "trading.order.request@1",
      "output_schema": "trading.order.output@1",
      "options": {"scene": "trading.place_order", "version": "trading.place_order@1"},
      "nodes": {
        "inventory": {
          "operator": "trading.inventory_check@1",
          "inputs": {"buyer": {"from": "flow.input.buyer", "required": true},
                     "items": {"from": "flow.input.items", "required": true}}
        },
        "pricing": {
          "type": "subflow",
          "flow": "pricing",
          "depends_on": ["inventory"],
          "inputs": {"items": {"from": "flow.input.items", "required": true},
                     "vip": {"from": "flow.input.buyer.vip", "required": true}}
        },
        "compose": {
          "operator": "trading.order_compose@1",
          "depends_on": ["pricing"],
          "inputs": {"buyer": {"from": "flow.input.buyer", "required": true},
                     "items": {"from": "flow.input.items", "required": true},
                     "payable": {"from": "nodes.pricing.output.data.payable", "required": true},
                     "available": {"from": "nodes.inventory.output.data.available", "required": true}}
        }
      },
      "outputs": {"order": {"from": "nodes.compose.output.data.order", "required": true}}
    }
  ]
}
